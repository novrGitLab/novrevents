# ─────────────────────────────────────────────────────────────────────────────
# NOVR Events web app — environment configuration
# Local development: copy to `.env.local`. Production: set these in Vercel (Project → Settings →
# Environment Variables). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ───────────────────────────────────────────────────

# Origin of the NOVR Events API. Server-side only (no NEXT_PUBLIC_ prefix): requests to /api/* on
# this app are proxied here, so the browser never talks to the API directly and the session cookie
# stays first-party. Production: https://api.novrevents.com. A Vercel build fails if it is missing.
API_URL=http://127.0.0.1:4000

# Public origin of this web app, used for canonical URLs, Open Graph, the sitemap and robots.txt.
# Production: https://novrevents.com. Only the production deployment with this exact value is
# indexable; previews and local builds are always "noindex".
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ── Deferred: email delivery ─────────────────────────────────────────────────

# Set to `enabled` only after the API delivers email (see the API's EMAIL_DRIVER). While unset, the
# interface never claims that a ticket, verification link or reset link was emailed.
NEXT_PUBLIC_EMAIL_DELIVERY=

# ── Local development and tests only ─────────────────────────────────────────

# Base URL for the Playwright end-to-end tests (`npm run test:e2e`).
# E2E_BASE_URL=http://localhost:3100
