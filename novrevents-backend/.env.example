# ─────────────────────────────────────────────────────────────────────────────
# NOVR Events API — environment configuration
# Local development: copy to `.env`. Production: set these as Railway service variables.
# Every name below is read by src/config/env.ts. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in production ───────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL. Railway: reference the database service, e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}
# (private network). The local value matches docker-compose.yml.
DATABASE_URL=postgresql://novr:novr_dev_password@localhost:5432/novrevents

# Public origin of the web app; used for links in emails, QR tickets and calendar files.
# Production: https://novrevents.com
APP_URL=http://localhost:3100

# Comma-separated browser origins allowed for credentialed, state-changing requests (the API also
# rejects POST/PUT/PATCH/DELETE whose Origin header is not listed). Production: https://novrevents.com
CORS_ORIGINS=http://localhost:3100

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Must be true in production (HTTPS only). The API refuses to start in production otherwise.
COOKIE_SECURE=false

# True behind a reverse proxy (Railway) so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# Uploaded files. `local` writes to STORAGE_LOCAL_DIR. In production this must be an absolute path
# on a persistent volume (Railway: volume mounted at /data → STORAGE_LOCAL_DIR=/data/uploads).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

# ── Optional (defaults shown) ────────────────────────────────────────────────

# Railway injects PORT; HOST must stay 0.0.0.0 inside a container.
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

SESSION_COOKIE_NAME=novr_session
SESSION_TTL_DAYS=30
# Leave empty. The web app proxies /api on its own origin, so the cookie is first-party without a
# Domain attribute.
COOKIE_DOMAIN=

# Password hashing (scrypt work factor as a power of two; 17 is the production default).
PASSWORD_HASH_LOG_N=17

# Rate limiting (disable only for local load testing).
RATE_LIMIT_ENABLED=true

# Background jobs (database-backed queue: reminders, outbox, maintenance).
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_MS=2000

# Interactive API documentation at /docs. Keep false in production.
API_DOCS_ENABLED=false

# S3-compatible storage (not used in the initial deployment; only read when STORAGE_DRIVER=s3).
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Deferred: email delivery ─────────────────────────────────────────────────
# `log` stores each message in the `messages` table and sends nothing. Keep `log` until email
# delivery is approved as a separate assignment. Do not set BREVO_API_KEY yet.
EMAIL_DRIVER=log
EMAIL_FROM_ADDRESS=events@example.com
EMAIL_FROM_NAME=NOVR Events
EMAIL_REPLY_TO=
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=

# ── Local development and tests only ────────────────────────────────────────
# Tests use their own database whose name must end in `_test` (see src/tests/test-env.ts).
# TEST_DATABASE_URL=postgresql://novr:novr_dev_password@localhost:5432/novrevents_test
